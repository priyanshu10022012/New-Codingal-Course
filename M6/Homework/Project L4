<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Restaurant Website</title>
<!-- ✅ FontAwesome -->
<link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" rel="stylesheet">
<style>
  body {
    font-family: Arial, sans-serif;
    margin: 0;
    line-height: 1.6;
  }

  header {
    background-color: #8B0000;
    color: #fff;
    padding: 20px;
    text-align: center;
  }

  nav {
    background: #333;
    color: #fff;
    display: flex;
    justify-content: center;
    gap: 20px;
    padding: 10px 0;
  }

  nav a {
    color: #fff;
    text-decoration: none;
  }

  section {
    padding: 40px 20px;
    max-width: 1200px;
    margin: auto;
  }

  h2 {
    text-align: center;
    margin-bottom: 10px;
  }

  p {
    text-align: center;
    margin-bottom: 30px;
    color: #555;
  }

  #portfolio {
    background-color: #f9f9f9;
  }

  #portfolio .grid {
    display: grid;
    gap: 20px;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
  }

  .card {
    background: white;
    border-radius: 8px;
    overflow: hidden;
    box-shadow: 0 2px 5px rgba(0,0,0,0.1);
    transition: transform 0.3s ease;
    cursor: pointer;
  }

  .card:hover {
    transform: scale(1.05);
  }

  .card img {
    width: 100%;
    height: 150px;
    object-fit: cover;
  }

  .card h3 {
    padding: 10px;
    font-size: 1.1em;
    color: #333;
  }

  /* Social Media Section Styles */
  #social {
    background: #f4f4f4;
    text-align: center;
    padding: 40px 20px;
  }

  #social h2 {
    margin-bottom: 10px;
  }

  #social p {
    margin-bottom: 20px;
    color: #555;
  }

  .social-icons {
    display: flex;
    justify-content: center;
    gap: 20px;
  }

  .social-icons a {
    font-size: 32px;
    color: #333;
    transition: transform 0.3s ease, color 0.3s ease;
  }

  .social-icons a:hover {
    transform: scale(1.2);
    color: #8B0000;
  }

  /* Footer Section Styles */
  footer {
    background: #222;
    color: #fff;
    text-align: center;
    padding: 20px;
  }

  footer p {
    margin: 5px 0;
  }
</style>
</head>
<body>

<header>
  <h1>🍽 Our Restaurant</h1>
  <p>Delicious food & great ambiance</p>
</header>

<nav>
  <a href="#about">About</a>
  <a href="#portfolio">Portfolio</a>
  <a href="#contact">Contact</a>
  <a href="#social">Social</a>
</nav>

<section id="about">
  <h2>About Us</h2>
  <p>Welcome to our restaurant where we serve happiness with every dish.</p>
</section>

<section id="portfolio">
  <h2>Our Portfolio</h2>
  <p>Explore our signature dishes and memorable events</p>
  <div class="grid">
    <div class="card">
      <img src="dish1.jpg" alt="Dish 1">
      <h3>Grilled Salmon</h3>
    </div>
    <div class="card">
      <img src="dish2.jpg" alt="Dish 2">
      <h3>Steak & Vegetables</h3>
    </div>
    <div class="card">
      <img src="dish3.jpg" alt="Dish 3">
      <h3>Chocolate Dessert</h3>
    </div>
    <div class="card">
      <img src="dish4.jpg" alt="Dish 4">
      <h3>Event Catering</h3>
    </div>
  </div>
</section>

<section id="contact">
  <h2>Contact Us</h2>
  <p>Email: info@restaurant.com | Phone: +91 9530998010</p>
</section>

<section id="social">
  <h2>Connect with Us</h2>
  <p>Follow us on social media to stay updated!</p>
  <div class="social-icons">
    <a href="https://www.facebook.com" target="_blank" aria-label="Facebook">
      <i class="fab fa-facebook-square"></i>
    </a>
    <a href="https://www.instagram.com" target="_blank" aria-label="Instagram">
      <i class="fab fa-instagram"></i>
    </a>
    <a href="https://www.twitter.com" target="_blank" aria-label="Twitter">
      <i class="fab fa-twitter"></i>
    </a>
    <a href="https://www.youtube.com" target="_blank" aria-label="YouTube">
      <i class="fab fa-youtube"></i>
    </a>
  </div>
</section>

<footer>
  <div class="footer-content">
    <p>&copy; 2025 Our Restaurant. All Rights Reserved.</p>
    <p>123 Main Street, Your City | +91 9876543210 | info@restaurant.com</p>
    <p>Website by YourName</p>
  </div>
</footer>

<script>
  document.querySelectorAll('#portfolio .card').forEach(card => {
    card.addEventListener('click', () => {
      alert(`You clicked on: ${card.querySelector('h3').textContent}`);
    });
  });
</script>

</body>
</html>