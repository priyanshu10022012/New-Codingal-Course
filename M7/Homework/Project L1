import sys

MOD = 1_000_000_007

# ----- common modular helpers -----
def add(a, b): return (a + b) % MOD
def sub(a, b): return (a - b) % MOD
def mul(a, b): return (a * b) % MOD
def powmod(a, e):  # a^e % MOD
    res = 1
    a %= MOD
    while e:
        if e & 1: res = (res * a) % MOD
        a = (a * a) % MOD
        e >>= 1
    return res
def inv(a):  # modular inverse, MOD is prime
    return powmod(a, MOD - 2)

